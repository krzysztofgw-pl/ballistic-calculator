<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: profiles go to cloud backup and to device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="profile.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="profile.xml" />
    </device-transfer>
</data-extraction-rules>
